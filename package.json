{
    "name": "ethical-web-analytics",
    "version": "0.0.1",
    "description": "An ethical alternative to modern web analytics like Google Analytics/GTM",
    "keywords": [
        "analytics",
        "gtm",
        "ethical",
        "gdpr",
        "gdpr-compliant"
    ],
    "homepage": "https://github.com/Voltra/ethical-web-analytics#readme",
    "bugs": {
        "url": "https://github.com/Voltra/ethical-web-analytics/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Voltra/ethical-web-analytics.git"
    },
    "license": "GPL-3.0",
    "author": "Voltra <dev@ludwig-guerin.fr>",
    "browser": "./dist/umd/ethicalWebAnalytics.js",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "exports": {
        ".": {
            "default": "./dist/index.js",
            "types": "./lib/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "scripts": {
        "prepare": "husky",
        "audit": "npm audit fix",
        "lint": "eslint --fix .",
        "format": "prettier --ignore-path .gitignore --write \"{src,tests}/**/*.{js,ts}\"",
        "build:umd": "webpack --mode production",
        "build:cjs": "tsc -p ./tsconfig.cjs.json",
        "build:esm": "tsc -p ./tsconfig.esm.json",
        "build": "npm run build:esm && npm run build:cjs && npm run build:umd",
        "test:mutation": "stryker run",
        "test": "vitest"
    },
    "dependencies": {
        "date-fns": "^4.4.0",
        "destr": "^2.0.5",
        "uuid": "^14.0.1"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/plugin-transform-class-properties": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@eslint/js": "^9.15.0",
        "@nuxt/friendly-errors-webpack-plugin": "^2.6.0",
        "@stryker-mutator/api": "^8.6.0",
        "@stryker-mutator/vitest-runner": "^8.7.1",
        "@stylistic/eslint-plugin-ts": "^2.13.0",
        "@types/eslint__js": "^8.42.3",
        "@types/node": "^22.20.0",
        "@types/webpack": "^5.28.5",
        "@vitest/coverage-v8": "^3.2.6",
        "@vitest/eslint-plugin": "^1.6.20",
        "babel-loader": "^9.2.1",
        "core-js": "^3.49.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^9.1.2",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "prettier": "^3.8.4",
        "stryker-cli": "^1.1.0",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.6.1",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vite": "^6.4.3",
        "vitest": "^3.1.1",
        "webpack": "^5.107.2",
        "webpack-cli": "^5.1.4",
        "webpackbar": "^6.0.1"
    }
}
