{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
        "rootDir": "./src",
		"outDir": "./dist/esm",
        "declarationDir": "./lib",
		"target": "ES6",
		"module": "ES6",
        "ignoreDeprecations": "6.0",
		"moduleResolution": "node",
		"tsBuildInfoFile": ".esm.tsbuildinfo",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true
    }
}
