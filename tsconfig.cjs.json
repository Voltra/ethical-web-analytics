		"outDir": "./dist/cjs",
		"declaration": false,
		"composite": false,
		"target": "ES6",
		"module": "commonjs",
        "ignoreDeprecations": "6.0",
		"moduleResolution": "node",
		"tsBuildInfoFile": ".cjs.tsbuildinfo"
	}
}
